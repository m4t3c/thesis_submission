# Variabili d'ambiente per il database MySQL (dev e prod).
#
# Docker Compose legge automaticamente un file chiamato ".env" in questa
# cartella e sostituisce i ${...} nei docker-compose*.yml al momento di
# "docker compose ... up" / "build".
#
# USO:
#   1. copia questo file:   cp .env.example .env
#   2. metti i valori reali nel ".env"
#   3. NON committare ".env" (e' gia' in .gitignore)
#
# NB: per ora tieni le password uguali a quelle attuali del database
# esistente, altrimenti l'app non riesce a connettersi (vedi istruzioni).

DB_NAME=appelli
DB_USER=appelli
DB_PASSWORD=metti_qui_la_password
MYSQL_ROOT_PASSWORD=metti_qui_la_password_root
